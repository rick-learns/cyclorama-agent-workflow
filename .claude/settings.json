{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "baseRef": "head" },
  "env": { "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10" },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
    "Read(~/.config/playcyclorama.env)",
    "Read(~/.config/playcyclorama-mail.env)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [
        { "type": "command", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/session-start-state.ts"], "timeout": 15, "statusMessage": "Reading STATE.md" }
      ] }
    ],
    "SubagentStart": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/subagent-start-context.ts"], "timeout": 10 }
      ] }
    ],
    "SubagentStop": [
      { "hooks": [
        { "type": "command", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/subagent-stop-inbox.ts"], "timeout": 20 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "if": "Bash(git *)", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/guard-failsafe.ts", "${CLAUDE_PROJECT_DIR}/tools/agent-guard.ts"], "timeout": 10 },
        { "type": "command", "if": "Bash(rm *)", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/guard-failsafe.ts", "${CLAUDE_PROJECT_DIR}/tools/agent-guard.ts"], "timeout": 10 },
        { "type": "command", "if": "Bash(cd *)", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/guard-failsafe.ts", "${CLAUDE_PROJECT_DIR}/tools/agent-guard.ts"], "timeout": 10 }
      ] },
      { "matcher": "PowerShell", "hooks": [
        { "type": "command", "if": "PowerShell(git *)", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/guard-failsafe.ts", "${CLAUDE_PROJECT_DIR}/tools/agent-guard.ts"], "timeout": 10 },
        { "type": "command", "if": "PowerShell(Remove-Item *)", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/guard-failsafe.ts", "${CLAUDE_PROJECT_DIR}/tools/agent-guard.ts"], "timeout": 10 },
        { "type": "command", "if": "PowerShell(Set-Location *)", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/guard-failsafe.ts", "${CLAUDE_PROJECT_DIR}/tools/agent-guard.ts"], "timeout": 10 }
      ] }
    ],
    "PostToolUse": [
      { "matcher": "Agent", "hooks": [
        { "type": "command", "command": "node", "args": ["--disable-warning=ExperimentalWarning", "${CLAUDE_PROJECT_DIR}/tools/hooks/agent-ledger.ts"], "async": true, "timeout": 10 }
      ] }
    ]
  }
}
