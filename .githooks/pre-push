#
# Opt-in per clone (the setting is shared by all worktrees of the clone):
#   git config core.hooksPath .githooks
# main changes only by `git merge --no-ff <branch>` (plus STATE.md/DECISIONS.md-only commits) and
# is never deleted; other refs pass. Reads git's ref lines on stdin. See tools/push-policy.ts.
# Branches that predate the policy have no tools/push-policy.ts: nothing to check with.
[ -f tools/push-policy.ts ] || exit 0
exec node --disable-warning=ExperimentalWarning tools/push-policy.ts "$@"
